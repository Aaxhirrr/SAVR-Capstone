              "title": "Search"
            },
            "description": "Text search on product name and brand"
          },
          {
            "name": "sort_by",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Sort field: price, product_name, valid_to",
              "default": "product_name",
              "title": "Sort By"
