        "operationId": "get_flyers_flyers_get",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "store_brand",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Store brand key, e.g. 'nofrills', 'metro'",
              "title": "Store Brand"
            },
            "description": "Store brand key, e.g. 'nofrills', 'metro'"
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
